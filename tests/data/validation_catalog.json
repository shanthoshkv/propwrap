{
  "meta": {
    "purpose": "Cited theoretical validation anchors for propwrap",
    "note": "All Isp values are ideal CEA theoretical (shifting equilibrium vacuum unless noted), NOT flight-delivered engine Isp.",
    "rocketcea_version_baseline": "1.2.3",
    "physics_kernel": "NASA CEA (Gordon & McBride) via RocketCEA Python wrapper",
    "last_physics_audit": "2026-07-29",
    "primary_sources": [
      {
        "id": "NASA-RP-1311",
        "title": "Computer Program for Calculation of Complex Chemical Equilibrium Compositions and Applications (CEA)",
        "authors": "S. Gordon, B. J. McBride",
        "publisher": "NASA Lewis Research Center",
        "refs": ["NASA RP-1311 Part I (1994)", "NASA RP-1311 Part II (1996)"],
        "url_ntrs_part1": "https://ntrs.nasa.gov/citations/19950013764",
        "role": "Defines the equilibrium rocket performance methodology propwrap wraps"
      },
      {
        "id": "ROCKETCEA-DOCS",
        "title": "RocketCEA documentation — QuickStart published LOX/LH2 Isp table",
        "url": "https://rocketcea.readthedocs.io/en/latest/quickstart.html",
        "role": "Externally published numerical goldens (bit-level match required)"
      },
      {
        "id": "BIPM-G0",
        "title": "Standard acceleration of gravity g0 = 9.80665 m/s²",
        "body": "CGPM / BIPM conventional standard gravity",
        "role": "ve = Isp · g0; Cf_vac = ve / c*"
      },
      {
        "id": "SI-BAR",
        "title": "1 bar = 10^5 Pa exactly",
        "body": "CIPM / SI derived unit relationship used for pc_bar ↔ pc_pa",
        "role": "Pressure unit conversion"
      }
    ],
    "secondary_literature_bands": [
      {
        "id": "CEA-CLASS-BANDS",
        "note": "Wide order-of-magnitude bands for theoretical vacuum Isp at high expansion; NOT flight numbers; used only as sanity envelopes",
        "examples": "LOX/kerosene ~340–370 s class; LOX/LH2 ~445–465 s class at ε~40, Pc~1000 psia; N2O4/MMH ~320–355 s class"
      }
    ]
  },
  "physics_identities": [
    {
      "id": "PHYS-VE-ISP-G0",
      "statement": "ve_vac [m/s] = isp_vac [s] × g0 with g0 = 9.80665 m/s²",
      "source": "BIPM-G0 + rocket definition of specific impulse",
      "test": "tests/test_physics_identities.py::test_ve_equals_isp_times_g0"
    },
    {
      "id": "PHYS-CF-VE-CSTAR",
      "statement": "cf_vac = ve / c* = isp_vac × g0 / c* (SI-consistent)",
      "source": "Standard rocket nozzle definitions (Sutton/CEA output relations)",
      "test": "tests/test_physics_identities.py::test_cf_vac_equals_ve_over_cstar"
    },
    {
      "id": "PHYS-PC-PE",
      "statement": "pc_pa / pe_pa = pc_over_pe from CEA",
      "source": "CEA rocket solution Pc/Pe",
      "test": "tests/test_physics_identities.py::test_pc_over_pe_matches_pressures"
    },
    {
      "id": "PHYS-RHO-IG",
      "statement": "Chamber gas density ≈ P·Mw/(R_univ·T) in SI",
      "source": "Ideal gas law with CEA Mw; R_univ = 8314.462618 J/(kmol·K)",
      "test": "tests/test_physics_identities.py::test_chamber_density_matches_ideal_gas"
    },
    {
      "id": "PHYS-BIT-ROCKETCEA",
      "statement": "propwrap.isp_vac_shifting == RocketCEA CEA_Obj.get_Isp at same Pc, MR, eps (machine precision)",
      "source": "ROCKETCEA-DOCS + direct CEA_Obj",
      "test": "tests/test_physics_identities.py::test_bit_level_match_rocketcea_lh2_docs"
    }
  ],
